{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (Grafana Cloud metrics)",
      "description": "The Grafana Cloud Prometheus datasource that observability/alloy/config.alloy's prometheus.remote_write ships to.",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki (Grafana Cloud logs)",
      "description": "The Grafana Cloud Loki datasource that observability/alloy/config.alloy's loki.write ships to.",
      "type": "datasource",
      "pluginId": "loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "1.0.0" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "1.0.0" }
  ],
  "title": "JobCopilot - VPS + Containers",
  "uid": "jobcopilot-overview",
  "description": "Host and per-container metrics + logs shipped by observability/alloy/config.alloy, scoped to this project's own jobcopilot-* containers only (see AGENTS.md's cross-tenant-scoping lesson - this dashboard's queries carry the same name=~\"jobcopilot-.*\" / container_name=~\"jobcopilot-.*\" filters Alloy itself applies before shipping, as a second layer, not because Alloy would ever forward anything else).",
  "tags": ["jobcopilot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "type": "row", "title": "VPS host", "id": 100, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "id": 1, "type": "timeseries", "title": "Host CPU usage",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{instance}}", "refId": "A"
        }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Host memory usage",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "{{instance}}", "refId": "A"
        }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Host disk usage (root filesystem)",
      "description": "mountpoint label may need adjusting to match how node_exporter reports it inside the alloy container's rootfs_path view - check Explore against node_filesystem_size_bytes first if this panel is empty.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"}))",
          "legendFormat": "{{instance}}", "refId": "A"
        }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Load average",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "node_load1", "legendFormat": "1m", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "node_load5", "legendFormat": "5m", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "node_load15", "legendFormat": "15m", "refId": "C" }
      ]
    },

    { "type": "row", "title": "Containers (jobcopilot-*)", "id": 200, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }, "collapsed": false, "panels": [] },
    {
      "id": 10, "type": "stat", "title": "Containers reporting",
      "description": "Count of distinct jobcopilot-* containers cAdvisor has seen recently. Compare against the real container count (7: postgres, rabbitmq, api, worker, frontend, notifications, alloy) - a drop below 7 is worth investigating even if nothing else alerts.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(count by (name) (container_last_seen{name=~\"jobcopilot-.*\"}))",
          "refId": "A", "instant": true
        }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Container CPU usage",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"jobcopilot-.*\"}[5m]))",
          "legendFormat": "{{name}}", "refId": "A"
        }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Container memory usage",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "container_memory_usage_bytes{name=~\"jobcopilot-.*\"}",
          "legendFormat": "{{name}}", "refId": "A"
        }
      ]
    },

    { "type": "row", "title": "Logs (jobcopilot-*)", "id": 300, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "collapsed": false, "panels": [] },
    {
      "id": 20, "type": "timeseries", "title": "Log volume by container",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (container_name) (rate({container_name=~\"jobcopilot-.*\"}[5m]))",
          "legendFormat": "{{container_name}}", "refId": "A"
        }
      ]
    },
    {
      "id": 21, "type": "timeseries", "title": "Error log rate (case-insensitive \"error\")",
      "description": "A coarse signal, not a precise error count - matches the literal substring \"error\" case-insensitively across all jobcopilot-* container logs. Good for \"did something change\", not for exact counts.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(rate({container_name=~\"jobcopilot-.*\"} |~ \"(?i)error\" [5m]))",
          "legendFormat": "errors/s", "refId": "A"
        }
      ]
    },
    {
      "id": 22, "type": "logs", "title": "Recent logs (all jobcopilot-* containers)",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{container_name=~\"jobcopilot-.*\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
