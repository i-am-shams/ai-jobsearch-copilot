# Copy to .env (gitignored, never commit real values - same discipline as
# the Gemini key in worker/, documented in docs/HANDOVER.md). Only needed to
# point this service at MongoDB Atlas instead of the local dev Mongo
# container; RabbitMQ defaults already match infra/docker-compose.dev.yml.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
